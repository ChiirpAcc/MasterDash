<body>
<div class="wrap">
  <header>
    <div>
      <h1 id="title">Sales scoreboard</h1>
      <p class="sub" id="sub">Loading the latest numbers…</p>
    </div>
    <div class="periods" role="group" aria-label="Period">
      <button type="button" data-p="thisMonth" aria-pressed="true">This month</button>
      <button type="button" data-p="lastMonth" aria-pressed="false">Last month</button>
      <button type="button" data-p="qtd" aria-pressed="false">Quarter</button>
      <button type="button" data-p="ytd" aria-pressed="false">Year</button>
    </div>
  </header>

  <main id="main">
    <div class="race" id="race" aria-live="polite"></div>
    <div class="key" aria-hidden="true"><span><i></i>New business</span><span><i class="exp"></i>Expansions</span></div>

    <div class="lower">
      <section class="panel" aria-labelledby="w-h">
        <h2 id="w-h">Waiting to be paid</h2>
        <p class="note">Won, but the customer hasn’t paid yet. These count the month they pay.</p>
        <ul class="waitlist" id="waitlist"></ul>
      </section>
      <section class="panel" aria-labelledby="m-h">
        <h2 id="m-h">Collected by month</h2>
        <p class="note">New revenue credited each month, by rep.</p>
        <div class="chart" id="chart"></div>
        <div class="legend" id="legend"></div>
      </section>
    </div>
  </main>

  <footer id="foot"></footer>
</div>

<script>
(function () {
  var state = { period: 'thisMonth', S: null, M: null, D: null };
  var REP_COLORS = ['#2F8F5B', '#223B6E', '#B7791F', '#7A4FB0', '#2C8C9A', '#B23A3A'];
  var money0 = new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD', maximumFractionDigits: 0 });
  var MONTHS = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
  function $(id) { return document.getElementById(id); }
  function el(tag, cls, text) { var e = document.createElement(tag); if (cls) e.className = cls; if (text != null) e.textContent = text; return e; }
  function monthName(mk, long) { var m = Number(mk.slice(5, 7)) - 1; return (long ? new Date(2000, m, 1).toLocaleString('en-US', { month: 'long' }) : MONTHS[m]) + (long ? ' ' + mk.slice(0, 4) : ''); }
  function label(p) {
    var per = state.S.meta.periods[p];
    if (p === 'thisMonth' || p === 'lastMonth') return monthName(per[0], true);
    if (p === 'qtd') return monthName(per[0]) + '–' + monthName(per[1]) + ' ' + per[1].slice(0, 4);
    return 'Year to date ' + per[1].slice(0, 4);
  }

  function fetchJson(f) {
    return fetch('data/' + f + '?v=' + Date.now(), { cache: 'no-store' }).then(function (r) {
      if (!r.ok) throw new Error(f + ' could not be loaded (HTTP ' + r.status + ')');
      return r.json();
    });
  }

  function renderRace() {
    var S = state.S, p = state.period, race = $('race');
    race.replaceChildren();
    var reps = S.reps.filter(function (r) { return r.onRoster; })
                     .sort(function (a, b) { return b[p].credited - a[p].credited || (a.ae < b.ae ? -1 : 1); });
    var max = Math.max.apply(null, reps.map(function (r) { return r[p].credited; }).concat([1]));
    reps.forEach(function (r, i) {
      var x = r[p], lane = el('div', 'lane');
      var nm = el('div', 'name'); nm.appendChild(el('span', 'rank num', String(i + 1)));
      nm.appendChild(document.createTextNode(r.ae)); lane.appendChild(nm);
      var track = el('div', 'track'); track.setAttribute('role', 'img');
      track.setAttribute('aria-label', r.ae + ': ' + money0.format(x.credited) + ' collected new revenue');
      var newBar = el('div', 'bar'), expBar = el('div', 'bar exp');
      track.appendChild(expBar); track.appendChild(newBar); lane.appendChild(track);
      var figs = el('div', 'figs');
      var big = el('span'); big.appendChild(el('span', 'big num', money0.format(x.credited))); big.appendChild(document.createTextNode('collected new revenue')); figs.appendChild(big);
      [['', x.dealsCollected, x.dealsCollected === 1 ? 'deal paid' : 'deals paid'],
       ['', x.dealsWon, x.dealsWon === 1 ? 'deal won' : 'deals won'],
       ['waiting', r.awaiting.deals, 'waiting to pay'],
       [r.awaiting.stale ? 'late' : '', r.awaiting.stale, 'over 60 days']].forEach(function (f, k) {
        if (k === 3 && !f[1]) return;
        var s = el('span', f[0]); s.appendChild(el('b', 'num', String(f[1]))); s.appendChild(document.createTextNode(' ' + f[2])); figs.appendChild(s);
      });
      lane.appendChild(figs);
      race.appendChild(lane);
      var newW = 100 * x.newCredited / max, totW = 100 * x.credited / max;
      requestAnimationFrame(function () { requestAnimationFrame(function () { newBar.style.width = newW + '%'; expBar.style.width = totW + '%'; }); });
    });
    var t = S.team[p], team = el('div', 'team');
    [['Team', money0.format(t.credited), 'collected new revenue'], ['', String(t.dealsCollected), 'deals paid'],
     ['', String(t.dealsWon), 'deals won'], ['', money0.format(t.booked), 'booked MRR won']].forEach(function (f) {
      var s = el('span'); if (f[0]) s.appendChild(document.createTextNode(f[0] + ' '));
      s.appendChild(el('span', 'num', f[1])); s.appendChild(document.createTextNode(' ' + f[2])); team.appendChild(s);
    });
    race.appendChild(team);
    $('sub').textContent = label(p) + '. Updated ' + new Date(S.meta.builtAt).toLocaleString('en-US', { month: 'short', day: 'numeric', hour: 'numeric', minute: '2-digit' }) + '.';
  }

  function renderWaiting() {
    var list = $('waitlist'); list.replaceChildren();
    var rows = state.D.rows.filter(function (d) { return d.status !== 'Collected' && d.status !== 'No Stripe link'; })
                          .sort(function (a, b) { return (b.waitingDays || 0) - (a.waitingDays || 0); }).slice(0, 25);
    if (!rows.length) { list.appendChild(el('li', 'empty', 'Every won deal has paid.')); return; }
    rows.forEach(function (d) {
      var li = el('li');
      var l = el('div'); l.appendChild(el('div', 'co', d.company || '(no company name)'));
      l.appendChild(el('div', 'who', d.ae + ', ' + d.type.toLowerCase() + ', won ' + new Date(d.close + 'T12:00').toLocaleDateString('en-US', { month: 'short', day: 'numeric' })));
      var r = el('div'); r.appendChild(el('div', 'amt num', money0.format(d.booked)));
      var late = (d.waitingDays || 0) > 60;
      r.appendChild(el('div', 'days' + (late ? ' late' : ''), (d.waitingDays || 0) + ' days waiting'));
      li.appendChild(l); li.appendChild(r); list.appendChild(li);
    });
  }

  function renderChart() {
    var M = state.M.rows, S = state.S;
    var reps = S.reps.filter(function (r) { return r.onRoster; }).map(function (r) { return r.ae; });
    var months = [], end = S.meta.month, y = Number(end.slice(0, 4)), m = Number(end.slice(5, 7));
    for (var i = 5; i >= 0; i--) { var mm = m - i, yy = y; while (mm < 1) { mm += 12; yy--; } months.push(yy + '-' + (mm < 10 ? '0' : '') + mm); }
    var val = {}; M.forEach(function (r) { val[r.ae + '|' + r.month] = r.credited; });
    var totals = months.map(function (mk) { return reps.reduce(function (s, a) { return s + (val[a + '|' + mk] || 0); }, 0); });
    var max = Math.max.apply(null, totals.concat([1]));
    var W = 520, H = 230, L = 52, B = 26, T = 10, bw = (W - L - 10) / months.length;
    var ns = 'http://www.w3.org/2000/svg', svg = document.createElementNS(ns, 'svg');
    svg.setAttribute('viewBox', '0 0 ' + W + ' ' + H); svg.setAttribute('role', 'img');
    svg.setAttribute('aria-label', 'Collected new revenue by month for the last six months, stacked by rep');
    function add(tag, attrs, text) { var e = document.createElementNS(ns, tag); for (var k in attrs) e.setAttribute(k, attrs[k]); if (text != null) e.textContent = text; svg.appendChild(e); return e; }
    [0, 0.5, 1].forEach(function (f) {
      var yy2 = T + (H - B - T) * (1 - f);
      add('line', { x1: L, x2: W - 6, y1: yy2, y2: yy2, class: 'axis' });
      add('text', { x: L - 8, y: yy2 + 4, 'text-anchor': 'end' }, f ? '$' + Math.round(max * f / 1000) + 'k' : '$0');
    });
    months.forEach(function (mk, i2) {
      var x = L + i2 * bw + bw * 0.18, w = bw * 0.64, acc = 0;
      reps.forEach(function (a, k) {
        var v = val[a + '|' + mk] || 0; if (!v) return;
        var h = (H - B - T) * v / max, yTop = T + (H - B - T) * (1 - (acc + v) / max);
        var r = add('rect', { x: x, y: yTop, width: w, height: Math.max(h, 0.5), fill: REP_COLORS[k % REP_COLORS.length], rx: 2 });
        var tt = document.createElementNS(ns, 'title'); tt.textContent = a + ', ' + monthName(mk) + ': ' + money0.format(v); r.appendChild(tt);
        acc += v;
      });
      add('text', { x: x + w / 2, y: H - 8, 'text-anchor': 'middle' }, monthName(mk));
    });
    var box = $('chart'); box.replaceChildren(svg);
    var lg = $('legend'); lg.replaceChildren();
    reps.forEach(function (a, k) { var s = el('span'); var i3 = el('i'); i3.style.background = REP_COLORS[k % REP_COLORS.length]; s.appendChild(i3); s.appendChild(document.createTextNode(a)); s.style.textTransform = 'capitalize'; lg.appendChild(s); });
  }

  function renderFoot() {
    var f = $('foot'); f.replaceChildren();
    f.appendChild(el('p', null, state.S.meta.rule + ' The first payment is capped at the deal’s MRR, so an annual prepay counts as one month.'));
    f.appendChild(el('p', null, 'An expansion counts once at least half of its MRR shows up above what the customer paid before. Payments come from Stripe (both accounts), net of refunds; deals come from HubSpot, credited to the deal’s Account Executive.'));
  }

  function render() { renderRace(); renderWaiting(); renderChart(); renderFoot(); }

  document.querySelectorAll('.periods button').forEach(function (b) {
    b.addEventListener('click', function () {
      state.period = b.getAttribute('data-p');
      document.querySelectorAll('.periods button').forEach(function (x) { x.setAttribute('aria-pressed', String(x === b)); });
      renderRace();
    });
  });

  function load() {
    Promise.all([fetchJson('summary.json'), fetchJson('monthly.json'), fetchJson('deals.json')]).then(function (r) {
      state.S = r[0]; state.M = r[1]; state.D = r[2]; render();
    }).catch(function (e) {
      var m = $('main'); m.replaceChildren();
      var box = el('div', 'error');
      box.appendChild(el('h2', null, 'The numbers didn’t load'));
      box.appendChild(el('p', null, e.message + '. Run the Sales KPI sheet once (Sales KPI menu, Run now) so the data files exist, then reload this page.'));
      m.appendChild(box); $('sub').textContent = '';
    });
  }
  load();
  setInterval(load, 15 * 60 * 1000);   // the sheet refreshes hourly; the page checks every 15 minutes
})();
</script>
</body>
</html>
