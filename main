    --paid: #2F8F5B;
    --wait: #B7791F;
    --late: #B23A3A;
    --focus: #3B6FD8;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      color-scheme: dark;
      --paper: #0F1626;
      --panel: #16203A;
      --ink: #E8ECF5;
      --navy: #8FB0F0;
      --muted: #97A1B8;
      --rule: #26324E;
      --lane: #1E2A45;
      --paid: #4DBB80;
      --wait: #E0A845;
      --late: #E27272;
      --focus: #7EA6FF;
    }
  }
  * { box-sizing: border-box; }
  html { scroll-padding-top: env(safe-area-inset-top, 0px); }
  body {
    margin: 0; background: var(--paper); color: var(--ink);
    font-family: "Barlow", "Segoe UI", Roboto, Arial, sans-serif; font-size: 16px; line-height: 1.45;
    padding: env(safe-area-inset-top, 0px) 0 env(safe-area-inset-bottom, 0px);
  }
  .wrap { max-width: 1120px; margin: 0 auto; padding: 32px 24px 48px; }
  .num, .name, h1, h2 { font-family: "Barlow Condensed", "Arial Narrow", Arial, sans-serif; }
  .num { font-variant-numeric: tabular-nums; }

  /* header */
  header { display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: 16px 32px; margin-bottom: 28px; }
  h1 { margin: 0; font-weight: 700; font-size: clamp(34px, 5vw, 52px); line-height: 1; letter-spacing: -0.01em; }
  .sub { margin: 6px 0 0; color: var(--muted); }
  .periods { display: flex; border: 1px solid var(--rule); border-radius: 8px; overflow: hidden; background: var(--panel); }
  .periods button {
    font: 600 15px "Barlow", Arial, sans-serif; color: var(--muted); background: none; border: 0;
    padding: 9px 14px; cursor: pointer; border-right: 1px solid var(--rule);
  }
  .periods button:last-child { border-right: 0; }
  .periods button[aria-pressed="true"] { color: #fff; background: var(--navy); }
  @media (prefers-color-scheme: dark) { .periods button[aria-pressed="true"] { color: var(--paper); } }
  button:focus-visible { outline: 3px solid var(--focus); outline-offset: -3px; }

  /* the race */
  .race { background: var(--panel); border: 1px solid var(--rule); border-radius: 12px; padding: 8px 24px 4px; }
  .lane { display: grid; grid-template-columns: minmax(130px, 200px) 1fr; gap: 6px 20px; align-items: center; padding: 18px 0; border-bottom: 1px solid var(--rule); }
  .lane:last-child { border-bottom: 0; }
  .name { font-weight: 600; font-size: 26px; line-height: 1.05; text-transform: capitalize; }
  .rank { color: var(--muted); font-weight: 500; font-size: 18px; margin-right: 6px; }
  .track { position: relative; height: 34px; background: var(--lane); border-radius: 6px; overflow: hidden; }
  .bar { position: absolute; inset: 0 auto 0 0; background: var(--paid); border-radius: 6px; width: 0; transition: width 900ms cubic-bezier(.2,.8,.2,1); }
  .bar.exp { background: color-mix(in srgb, var(--paid) 55%, var(--panel)); }
  .figs { grid-column: 2; display: flex; flex-wrap: wrap; gap: 4px 22px; color: var(--muted); font-size: 15px; }
  .figs .big { color: var(--ink); font-size: 30px; font-weight: 700; line-height: 1; margin-right: 4px; }
  .figs b { color: var(--ink); font-weight: 600; }
  .figs .waiting b { color: var(--wait); }
  .figs .late b { color: var(--late); }
  .team { display: flex; flex-wrap: wrap; gap: 6px 28px; padding: 16px 0 20px; color: var(--muted); border-top: 2px solid var(--ink); margin-top: 4px; }
  .team .num { color: var(--ink); font-size: 22px; font-weight: 700; }
  .key { display: flex; gap: 18px; color: var(--muted); font-size: 14px; margin: 12px 4px 0; }
  .key i { display: inline-block; width: 12px; height: 12px; border-radius: 3px; margin-right: 6px; vertical-align: -1px; background: var(--paid); }
  .key i.exp { background: color-mix(in srgb, var(--paid) 55%, var(--panel)); }

  /* lower half */
  .lower { display: grid; grid-template-columns: 1.15fr 1fr; gap: 24px; margin-top: 32px; }
  h2 { font-weight: 600; font-size: 26px; margin: 0 0 4px; }
  .note { color: var(--muted); margin: 0 0 14px; font-size: 15px; }
  section.panel { background: var(--panel); border: 1px solid var(--rule); border-radius: 12px; padding: 20px 22px; min-width: 0; }
  .waitlist { list-style: none; margin: 0; padding: 0; }
  .waitlist li { display: grid; grid-template-columns: 1fr auto; gap: 2px 12px; padding: 10px 0; border-bottom: 1px solid var(--rule); }
  .waitlist li:last-child { border-bottom: 0; }
  .waitlist .co { font-weight: 600; }
  .waitlist .who { color: var(--muted); font-size: 14px; }
  .waitlist .amt { text-align: right; font-size: 20px; font-weight: 600; }
  .waitlist .days { text-align: right; font-size: 14px; color: var(--wait); }
  .waitlist .days.late { color: var(--late); font-weight: 600; }
  .empty { color: var(--muted); padding: 8px 0; }
  .chart { overflow-x: auto; }
  .chart svg { display: block; min-width: 420px; width: 100%; height: auto; }
  .chart text { fill: var(--muted); font: 13px "Barlow", Arial, sans-serif; }
  .chart .axis { stroke: var(--rule); }
  .legend { display: flex; flex-wrap: wrap; gap: 6px 16px; margin-top: 8px; font-size: 14px; color: var(--muted); }
  .legend i { display: inline-block; width: 12px; height: 12px; border-radius: 3px; margin-right: 6px; vertical-align: -1px; }
  footer { margin-top: 32px; color: var(--muted); font-size: 15px; max-width: 72ch; }
  footer p { margin: 0 0 8px; }
  .error { background: var(--panel); border: 1px solid var(--late); border-radius: 12px; padding: 20px; }

  @media (max-width: 760px) {
    .wrap { padding: 20px 16px 36px; }
    .lane { grid-template-columns: 1fr; }
    .figs { grid-column: 1; }
    .lower { grid-template-columns: 1fr; }
    .periods button { padding: 8px 10px; font-size: 14px; }
  }
  @media (prefers-reduced-motion: reduce) { .bar { transition: none; } }
